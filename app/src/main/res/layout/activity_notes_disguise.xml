<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical">

    <!-- Top Notes Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1E1E1E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tvNotesAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:text="📝 Quick Notes"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Discreet Secret Unlock Button -->
        <ImageButton
            android:id="@+id/btnSecretUnlock"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Options"
            android:src="@android:drawable/ic_menu_more"
            app:tint="#888888" />
    </LinearLayout>

    <!-- Search bar lookalike -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_card_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍 Search notes..."
            android:textColor="#666666"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Note Pad Text Editor -->
    <EditText
        android:id="@+id/etNotePad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_weight="1"
        android:background="@null"
        android:gravity="top|start"
        android:hint="Start typing your notes here..."
        android:lineSpacingExtra="4dp"
        android:padding="8dp"
        android:textColor="#E0E0E0"
        android:textColorHint="#555555"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvNotesSavedStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Saved locally"
        android:textColor="#555555"
        android:textSize="12sp" />

</LinearLayout>
